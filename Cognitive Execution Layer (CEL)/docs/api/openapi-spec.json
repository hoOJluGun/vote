{
  "openapi": "3.0.3",
  "info": {
    "title": "Cognitive Execution Layer (CEL) API",
    "description": "Autonomous Engineering API for AI-powered code development and system management",
    "version": "1.0.0",
    "contact": {
      "name": "CEL Development Team",
      "email": "support@cel-project.org"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    },
    {
      "url": "https://api.cel-project.org",
      "description": "Production server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check endpoint",
        "description": "Returns the health status of the CEL system",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "System is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/usage": {
      "get": {
        "summary": "Get system usage statistics",
        "description": "Returns current system resource usage and statistics",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Usage statistics retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "summary": "List available models",
        "description": "Returns a list of available AI models for different tasks",
        "tags": ["Models"],
        "responses": {
          "200": {
            "description": "Models list retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "summary": "Chat completions endpoint",
        "description": "Generate AI responses for chat interactions",
        "tags": ["AI"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat completion generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid input"
          }
        }
      }
    },
    "/v1/run-tests": {
      "post": {
        "summary": "Run tests on code",
        "description": "Execute tests for the specified code or project",
        "tags": ["Testing"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tests executed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/lint-code": {
      "post": {
        "summary": "Lint code for issues",
        "description": "Analyze code for style and quality issues",
        "tags": ["Code Quality"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LintRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Code linting completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LintResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/code-assist": {
      "post": {
        "summary": "Get AI code assistance",
        "description": "Get AI-powered suggestions and assistance for code development",
        "tags": ["AI"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeAssistRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Code assistance provided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeAssistResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/orchestrate-goal": {
      "post": {
        "summary": "Orchestrate system goals",
        "description": "Coordinate and execute complex system goals across multiple agents",
        "tags": ["Orchestration"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrchestrationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Goal orchestration initiated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestrationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/project-context/{path}": {
      "get": {
        "summary": "Get project context",
        "description": "Retrieve context information for a specific project path",
        "tags": ["Project"],
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "description": "Project path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project context retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectContextResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/solve-design-constraints": {
      "post": {
        "summary": "Solve design constraints",
        "description": "Find solutions to system design constraints using constraint solving algorithms",
        "tags": ["Constraints"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConstraintSolvingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Constraint solving completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConstraintSolvingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/register-agent": {
      "post": {
        "summary": "Register an agent",
        "description": "Register a new autonomous agent in the system",
        "tags": ["Agents"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterAgentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterAgentResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "healthy"
          },
          "uptime": {
            "type": "number",
            "description": "System uptime in seconds",
            "example": 3600
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-15T10:30:00Z"
          }
        }
      },
      "UsageResponse": {
        "type": "object",
        "properties": {
          "cpu": {
            "type": "number",
            "description": "CPU usage percentage",
            "example": 45.2
          },
          "memory": {
            "type": "number",
            "description": "Memory usage percentage",
            "example": 67.8
          },
          "disk": {
            "type": "number",
            "description": "Disk usage percentage",
            "example": 23.4
          },
          "requests": {
            "type": "number",
            "description": "Requests per second",
            "example": 150
          }
        }
      },
      "ModelsResponse": {
        "type": "object",
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "example": "gpt-4-turbo"
                },
                "name": {
                  "type": "string",
                  "example": "GPT-4 Turbo"
                },
                "capabilities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "example": ["chat", "code", "analysis"]
                },
                "maxTokens": {
                  "type": "number",
                  "example": 128000
                }
              }
            }
          }
        }
      },
      "ChatCompletionRequest": {
        "type": "object",
        "required": ["messages"],
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["system", "user", "assistant"],
                  "example": "user"
                },
                "content": {
                  "type": "string",
                  "example": "Write a function to calculate fibonacci numbers"
                }
              }
            }
          },
          "model": {
            "type": "string",
            "example": "gpt-4-turbo"
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "example": 0.7
          }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "chatcmpl-123"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string",
                      "example": "assistant"
                    },
                    "content": {
                      "type": "string",
                      "example": "Here's a function to calculate fibonacci numbers..."
                    }
                  }
                },
                "finish_reason": {
                  "type": "string",
                  "example": "stop"
                }
              }
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "prompt_tokens": {
                "type": "number",
                "example": 50
              },
              "completion_tokens": {
                "type": "number",
                "example": 120
              },
              "total_tokens": {
                "type": "number",
                "example": 170
              }
            }
          }
        }
      },
      "TestRequest": {
        "type": "object",
        "properties": {
          "filePath": {
            "type": "string",
            "example": "./src/example.js"
          },
          "testFramework": {
            "type": "string",
            "example": "jest"
          },
          "options": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "TestResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "summary": {
            "type": "string",
            "example": "All tests passed"
          },
          "duration": {
            "type": "number",
            "example": 2.34
          }
        }
      },
      "LintRequest": {
        "type": "object",
        "properties": {
          "filePath": {
            "type": "string",
            "example": "./src/example.js"
          },
          "linter": {
            "type": "string",
            "example": "eslint"
          }
        }
      },
      "LintResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "line": {
                  "type": "number"
                },
                "column": {
                  "type": "number"
                },
                "message": {
                  "type": "string"
                },
                "severity": {
                  "type": "string",
                  "enum": ["error", "warning", "info"]
                }
              }
            }
          },
          "summary": {
            "type": "string",
            "example": "2 errors, 5 warnings"
          }
        }
      },
      "CodeAssistRequest": {
        "type": "object",
        "required": ["task"],
        "properties": {
          "task": {
            "type": "string",
            "example": "Refactor this function to be more efficient"
          },
          "code": {
            "type": "string",
            "example": "function inefficientFunction(arr) { ... }"
          },
          "context": {
            "type": "string",
            "example": "Performance optimization request"
          }
        }
      },
      "CodeAssistResponse": {
        "type": "object",
        "properties": {
          "suggestions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "refactor"
                },
                "description": {
                  "type": "string",
                  "example": "Optimize loop structure"
                },
                "code": {
                  "type": "string",
                  "example": "const optimizedCode = ..."
                }
              }
            }
          },
          "confidence": {
            "type": "number",
            "example": 0.95
          }
        }
      },
      "OrchestrationRequest": {
        "type": "object",
        "required": ["goal"],
        "properties": {
          "goal": {
            "type": "string",
            "example": "Implement user authentication system"
          },
          "priority": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "example": "high"
          },
          "deadline": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-20T10:00:00Z"
          }
        }
      },
      "OrchestrationResponse": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "example": "task-12345"
          },
          "status": {
            "type": "string",
            "example": "initiated"
          },
          "assignedAgents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["code-generator", "tester", "reviewer"]
          }
        }
      },
      "ProjectContextResponse": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "example": "/projects/my-app"
          },
          "structure": {
            "type": "object",
            "additionalProperties": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "framework": {
            "type": "string",
            "example": "React"
          }
        }
      },
      "ConstraintSolvingRequest": {
        "type": "object",
        "required": ["constraints"],
        "properties": {
          "constraints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "performance"
                },
                "variables": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "predicate": {
                  "type": "string",
                  "example": "responseTime < 100"
                }
              }
            }
          },
          "optimization": {
            "type": "string",
            "example": "minimize_cost"
          }
        }
      },
      "ConstraintSolvingResponse": {
        "type": "object",
        "properties": {
          "solved": {
            "type": "boolean",
            "example": true
          },
          "solution": {
            "type": "object",
            "additionalProperties": true
          },
          "score": {
            "type": "number",
            "example": 0.92
          },
          "iterations": {
            "type": "number",
            "example": 150
          }
        }
      },
      "RegisterAgentRequest": {
        "type": "object",
        "required": ["agentId", "capabilities"],
        "properties": {
          "agentId": {
            "type": "string",
            "example": "code-reviewer-1"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["code_review", "static_analysis"]
          },
          "configuration": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "RegisterAgentResponse": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string",
            "example": "code-reviewer-1"
          },
          "registered": {
            "type": "boolean",
            "example": true
          },
          "registrationTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "System-level operations and health checks"
    },
    {
      "name": "AI",
      "description": "AI-powered code generation and assistance"
    },
    {
      "name": "Models",
      "description": "AI model management and selection"
    },
    {
      "name": "Testing",
      "description": "Code testing and validation"
    },
    {
      "name": "Code Quality",
      "description": "Code linting and quality analysis"
    },
    {
      "name": "Orchestration",
      "description": "Multi-agent coordination and goal management"
    },
    {
      "name": "Project",
      "description": "Project context and structure management"
    },
    {
      "name": "Constraints",
      "description": "Design constraint solving and optimization"
    },
    {
      "name": "Agents",
      "description": "Autonomous agent management"
    }
  ]
}