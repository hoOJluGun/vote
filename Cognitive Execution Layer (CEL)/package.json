{
  "name": "cognitive-execution-layer",
  "version": "4.2.1",
  "description": "LLM Control Plane v4.2 - Next Generation Agent IDE Orchestration Engine",
  "type": "module",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "nodemon src/server/index.js",
    "debug": "node --inspect src/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "health": "node scripts/health-check.js",
    "cli": "node cli/enhanced-cli.js",
    "cli-dev": "node cli/enhanced-cli.js --dev",
    "web-ide": "cd ide/web-ide && npm run dev",
    "stats-engine": "cd stats_engine && python -m uvicorn app.main:app --reload",
    "test:integration": "CEL_BASE_URL=http://localhost:3000 vitest run __tests__/integration/server-integration.test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.18.0",
    "axios": "^1.13.5",
    "bytenode": "^1.5.0",
    "cheerio": "^1.0.0-rc.12",
    "chromadb": "^1.7.3",
    "commander": "^11.0.0",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "form-data": "^4.0.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "gradient-string": "^2.0.2",
    "highlight.js": "^11.9.0",
    "http-proxy-middleware": "^2.0.6",
    "https-proxy-agent": "^7.0.2",
    "ignore": "^5.3.0",
    "keyv": "^4.5.4",
    "log4js": "^6.9.1",
    "moment": "^2.30.1",
    "node-fetch": "^3.3.2",
    "node-forge": "^1.3.1",
    "normalize-path": "^3.0.0",
    "ora": "^7.0.1",
    "path-browserify": "^1.0.1",
    "pdf-parse": "^1.1.1",
    "qs": "^6.11.2",
    "recursive-readdir": "^2.2.3",
    "semver": "^7.5.4",
    "tar": "^6.2.0",
    "util": "^0.12.5",
    "uuid": "^9.0.1",
    "zustand": "^4.4.1",
    "lucide-react": "^0.312.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "framer-motion": "^10.16.4",
    "monaco-editor": "^0.44.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitest/ui": "^1.2.1",
    "jsdom": "^24.0.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4",
    "tailwindcss": "^4.2.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  },
  "keywords": [
    "ai",
    "llm",
    "orchestration",
    "automation",
    "typescript",
    "react",
    "express"
  ]
}
