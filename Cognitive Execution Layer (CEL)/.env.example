# Cognitive Execution Layer (CEL) Environment Configuration

# API Keys and Authentication
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Semantic Caching Configuration
SEMANTIC_CACHE_SIZE=1000
SEMANTIC_CACHE_TTL=86400000  # 24 hours in milliseconds
SEMANTIC_SIMILARITY_THRESHOLD=0.85

# RAG (Retrieval Augmented Generation) Configuration
CONTEXT_WINDOW_SIZE=3072
CHUNK_SIZE=512
OVERLAP=50
TOP_K=5

# Provider Configuration
OPENROUTER_BASE=https://openrouter.ai/api/v1
PREFER_LOCAL_MODELS=true
PROVIDER_FALLBACK_ORDER=openrouter,ollama

# Ollama Configuration (optional)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434

# Project Path for RAG
PROJECT_PATH=

# Usage and Budget Limits
USAGE_BUDGET_LIMIT=5000  # Set to null to disable limit

# Feature Flags
USE_RAG=true