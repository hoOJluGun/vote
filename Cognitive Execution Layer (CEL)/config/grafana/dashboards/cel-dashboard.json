{
  "dashboard": {
    "id": null,
    "title": "CEL System Monitoring",
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "type": "graph",
        "title": "System Resources",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "process_cpu_percent",
            "legendFormat": "CPU Usage %",
            "refId": "A"
          },
          {
            "expr": "process_memory_rss_bytes / 1024 / 1024",
            "legendFormat": "Memory Usage MB",
            "refId": "B"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Current Status",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 4
        },
        "targets": [
          {
            "expr": "up{job=\"cel-core\"}",
            "legendFormat": "Core Service",
            "refId": "A"
          },
          {
            "expr": "up{job=\"cel-ai-router\"}",
            "legendFormat": "AI Router",
            "refId": "B"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "id": 3,
        "type": "graph",
        "title": "Request Rate & Latency",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(http_requests_total[5m])",
            "legendFormat": "{{method}} {{status}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m])) * 1000",
            "legendFormat": "95th Percentile (ms)",
            "refId": "B"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "id": 4,
        "type": "table",
        "title": "Top Endpoints by Request Count",
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "topk(10, sum by(path) (rate(http_requests_total[5m])))",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "id": 5,
        "type": "graph",
        "title": "Error Rates",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 12,
          "h": 6
        },
        "targets": [
          {
            "expr": "rate(http_requests_total{status=~\"5..\"}[5m])",
            "legendFormat": "5xx Errors",
            "refId": "A"
          },
          {
            "expr": "rate(http_requests_total{status=~\"4..\"}[5m])",
            "legendFormat": "4xx Errors",
            "refId": "B"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "id": 6,
        "type": "heatmap",
        "title": "Request Duration Distribution",
        "gridPos": {
          "x": 12,
          "y": 16,
          "w": 12,
          "h": 6
        },
        "targets": [
          {
            "expr": "rate(http_request_duration_seconds_bucket[5m])",
            "format": "heatmap",
            "legendFormat": "Duration",
            "refId": "A"
          }
        ],
        "datasource": "Prometheus"
      }
    ],
    "templating": {
      "list": [
        {
          "name": "job",
          "type": "query",
          "datasource": "Prometheus",
          "refresh": 1,
          "query": "label_values(job)"
        }
      ]
    }
  }
}