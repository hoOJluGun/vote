{
  "name": "cognitive-execution-layer",
  "version": "4.2.1",
  "description": "LLM Control Plane for Autonomous Engineering and Xcode Integration. A scientifically-validated autonomous software engineering system designed for deep Xcode integration.",
  "main": "src/server/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "nodemon src/server/index.js",
    "ide": "cd ide/web-ide && npm run dev",
    "ide:build": "cd ide/web-ide && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run __tests__/unit",
    "test:integration": "vitest run __tests__/integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "echo \"No build step required for Node.js application\"",
    "health": "node -e \"console.log('System health check:'); console.log('- Node version:', process.version); console.log('- Platform:', process.platform); console.log('- Architecture:', process.arch); console.log('- CEL Version: 4.2.1');\"",
    "xcode-setup": "echo \"Setting up Xcode integration...\" && mkdir -p xcode/build",
    "cel-client": "echo \"CEL Client ready at ./xcode/CELClient.swift\""
  },
  "keywords": [
    "llm",
    "control-plane",
    "autonomous-engineering",
    "xcode",
    "ide",
    "ai",
    "orchestration",
    "cognitive",
    "formal-verification",
    "self-healing",
    "multi-agent",
    "deterministic-execution"
  ],
  "author": "CEL Team",
  "license": "MIT",
  "dependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "lru-cache": "^11.2.6",
    "lucide-react": "^0.575.0",
    "node-fetch": "^3.3.2",
    "node-vault": "^0.10.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@vitest/coverage-v8": "^3.2.4",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.0",
    "tailwindcss-animate": "^1.0.7",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cel-project/cognitive-execution-layer.git"
  },
  "bugs": {
    "url": "https://github.com/cel-project/cognitive-execution-layer/issues"
  },
  "homepage": "https://github.com/cel-project/cognitive-execution-layer#readme"
}
